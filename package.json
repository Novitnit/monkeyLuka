{
  "name": "monkeyluka",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web",
    "dev:web": "cd apps/web && bun run dev",
    "dev:server": "cd apps/server && bun run dev",
    "build:web": "cd apps/web && bun run build",
    "start:server": "cd apps/server && bun run start",
    "typecheck": "bun run typecheck:web && bun run typecheck:server && bun run typecheck:shared",
    "typecheck:web": "cd apps/web && tsc --noEmit",
    "typecheck:server": "cd apps/server && tsc --noEmit",
    "typecheck:shared": "cd packages/shared && tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "patchedDependencies": {
    "@colyseus/better-call@1.3.3": "patches/@colyseus%2Fbetter-call@1.3.3.patch"
  }
}
