# Cloudflare Zero Trust → Networks → Tunnels → create a tunnel →
# "Install and run a connector" → copy the token here. compose.yaml reads it
# as the cloudflared container's TUNNEL_TOKEN. Copy to .env (gitignored).
CLOUDFLARE_TUNNEL_TOKEN=

# Browser → Colyseus endpoint, inlined into the client at docker build time
# (NEXT_PUBLIC_*): the tunnel host mapped to server:3001. Rebuild `next`
# after changing (docker compose build next; docker compose up -d).
NEXT_PUBLIC_COLYSEUS_ENDPOINT=wss://server.monkeyluka.online