# Realtime (Colyseus) — the server's only job; the REST API moved into the web
# app under /api (apps/web/src/app/api/[[...slugs]]/route.ts, Elysia×Next.js).
COLYSEUS_PORT=2567
HOST=0.0.0.0

# Allowed browser origins for the Colyseus WebSocket handshake — comma-separated
# host allowlist, e.g. "localhost,192.168.1.109" keeps both localhost and LAN
# dev working (mirrored in apps/web/.env for the /api CORS + Next dev origins).
# `*` or unset allows any origin.
ALLOWED_ORIGIN_HOST=localhost,192.168.1.109

# How long a dropped client's seat + world entry are held for reconnection
# (page reload / network blip) before the player is removed, seconds.
JUNGLE_RECONNECT_SECONDS=30

# Debug extras shared with the browser client: the collision overlay and the
# R-key checkpoint return are gated by this flag in apps/web/.env only — the
# server's checkpoint-message handler is always registered (its target is the
# server-chosen spawn, so it can't bypass the anti-cheat).
# NEXT_PUBLIC_DEBUG=true
