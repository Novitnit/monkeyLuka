# Realtime (Colyseus) — the server's only job; the REST API moved into the web
# app under /api (apps/web/src/app/api/[[...slugs]]/route.ts, Elysia×Next.js).
COLYSEUS_PORT=2567
HOST=0.0.0.0

# Allowed browser origin host for the Colyseus WebSocket handshake (mirrored
# in apps/web/.env for the /api CORS + Next dev origins).
ALLOWED_ORIGIN_HOST=192.168.1.109