# Allowed dev origins — feeds next.config.ts allowedDevOrigins AND the Elysia
# /api CORS (src/app/api/[[...slugs]]/route.ts). Comma-separated host allowlist
# (Next allows localhost by default; entries here add LAN hosts). Next.js loads
# .env before evaluating next.config.ts.
ALLOWED_ORIGIN_HOST=localhost,192.168.1.109

# Colyseus matchmaker endpoint used by the browser client. Defaults to
# ws://<page-hostname>:2567 (server port from apps/server .env), so LAN dev
# against the machine serving the page just works. Override to point at
# another host/port.
# NEXT_PUBLIC_COLYSEUS_ENDPOINT=ws://192.168.1.109:2567

# Where the /leaderboard page reads completed runs from. The Colyseus room
# writes to this (see apps/server/.env.example); the leaderboard reader
# (`src/lib/leaderboard.ts`) honors the same var, defaulting to
# ../server/data/jungle-runs.sqlite relative to the web app's CWD. Absolute
# path, or relative to THIS app's CWD.
# JUNGLE_RUN_RESULTS_PATH=/abs/path/to/jungle-runs.sqlite

# Collision-debug overlay on the jungle map (green walls, blue floors, orange
# slopes). Shown when this is "true"/"1", hidden otherwise. NEXT_PUBLIC_
# prefix so the browser client sees it (plain DEBUG is server-only in Next).
# NEXT_PUBLIC_DEBUG=true

# Door-link debug lines on the jungle map (cyan signpost → door per room
# objectgroup name group). "true"/"1" shows them, hidden otherwise; runs
# independently of NEXT_PUBLIC_DEBUG so the link preview doesn't need the
# full collision overlay. Toggle at runtime via `__jungleDoorDebug`.
# NEXT_PUBLIC_DOOR_DEBUG=true
