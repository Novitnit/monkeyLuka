# Allowed dev origins — feeds next.config.ts allowedDevOrigins AND the Elysia
# /api CORS (src/app/api/[[...slugs]]/route.ts). Comma-separated host allowlist
# (Next allows localhost by default; entries here add LAN hosts). Next.js loads
# .env before evaluating next.config.ts.
ALLOWED_ORIGIN_HOST=localhost,192.168.1.109

# Colyseus matchmaker endpoint used by the browser client. Defaults to
# ws://<page-hostname>:2567 (server port from apps/server .env), so LAN dev
# against the machine serving the page just works. Override to point at
# another host/port.
# NEXT_PUBLIC_COLYSEUS_ENDPOINT=ws://192.168.1.109:2567
